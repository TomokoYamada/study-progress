<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.study-progress</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/study-progress/.venv/bin/python</string>
        <string>-u</string>
        <string>/ABSOLUTE/PATH/TO/study-progress/python/watch_slack.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/study-progress</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/study-progress/logs/watch_slack.log</string>

    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/study-progress/logs/watch_slack_error.log</string>
</dict>
</plist>
